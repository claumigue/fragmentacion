---
import { connections } from '../data/connections';

// Maps discipline key to its CSS variable
const colorVar: Record<string, string> = {
	accent:     'var(--accent)',
	literatura: 'var(--lit)',
	cine:       'var(--cin)',
	musica:     'var(--mus)',
	visuales:   'var(--vis)',
};
---

<section class="connections-section">
	<div class="section-label">Genealogía de ideas</div>
	<h2 class="section-title">Conexiones entre tradiciones</h2>

	<div class="connections-grid">
		{connections.map((conn) => (
			<div class="connection-card">
				<span class="connection-arrow" style={`color:${colorVar[conn.discipline]}`}>→</span>
				<div class="connection-title">{conn.title}</div>
				<p class="connection-desc">{conn.desc}</p>
			</div>
		))}
	</div>
</section>